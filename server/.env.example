# ==============================================================================
# SKY POWER SWITCHGEARS ERP - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

PORT=5000
NODE_ENV=development

# Cloud MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/switchgear_erp?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/switchgear_erp?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=sky_power_switchgears_jwt_secure_key_2026_production
JWT_EXPIRES_IN=24h

# Uploads
UPLOAD_DIR=uploads

