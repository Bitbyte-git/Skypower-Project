# ==============================================================================
# SKY POWER SWITCHGEARS ERP - FRONTEND ENVIRONMENT CONFIGURATION (Vite)
# ==============================================================================
# In Vite, all client-exposed environment variables MUST be prefixed with VITE_
# Access in code using: import.meta.env.VITE_VAR_NAME
# ==============================================================================

# Backend API Base URL
# Option 1: Use relative path '/api' when using Vite dev proxy (recommended for local dev)
# Option 2: Use full URL 'http://localhost:5000/api' or production domain 'https://api.skypower.co.in/api'
VITE_API_BASE_URL=http://localhost:5000/api

# API Request Timeout (in milliseconds)
VITE_API_TIMEOUT=15000

# Application Metadata
VITE_APP_NAME="Sky Power Switchgears ERP"
VITE_APP_ENV=development

